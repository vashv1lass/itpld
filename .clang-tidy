# NOTE: This file was almost fully generated by LLM (Claude).

Checks: >
  clang-diagnostic-*,
  clang-analyzer-*,
  bugprone-*,
  cert-*,
  misc-*,
  performance-*,
  portability-*,
  readability-*,
  -readability-identifier-length,
  -readability-magic-numbers,
  -readability-braces-around-statements,
  -bugprone-easily-swappable-parameters,

WarningsAsErrors: >
  clang-analyzer-*,
  bugprone-*,
  cert-*,
  portability-*

HeaderFilterRegex: '^.*/(include|src|tools)/.*\.(h|c)$'

FormatStyle: file

CheckOptions:
  - key: readability-function-cognitive-complexity.Threshold
    value: "25"

  - key: bugprone-suspicious-enum-usage.StrictMode
    value: "false"
